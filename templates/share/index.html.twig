{% extends 'base.html.twig' %}

{% block localstyle %}
<style>
    verysmall { zoom:70%; }
    big { zoom: 130%; }

    table h1, {
        font-size: 2rem;
    }
    table h2 {
        font-size: 1.7rem;
        border-bottom: 1px solid #f89fa;
    }

    table h3 {
        font-size: 1.4rem;
    }

    surline {
        background-color: #fff;
        color: #000;
        padding:5px;
        display: block;
        font-weight: bold;
        zoom: 130%;
    }

    .btn-collapse:hover {
        background-color: #f8f9fa !important;
        color: #000;
        filter: brightness(95%);
    }

    .btn-collapse::after {
        content: '▼';
        font-size: 0.8em;
        margin-left: 10px;
        transition: transform 0.3s;
    }

    .btn-collapse[aria-expanded="true"]::after {
        transform: rotate(180deg);
    }
</style>
{% endblock %}

{% block body %}
    {% include 'home/table.html.twig' with {shareLabel: shareLabel, readOnly: readOnly} %}
{% endblock %}

{% block localscript %}
<script>
(function() {
    var STORAGE_KEY_PA = 'labelnr_pa_open';
    var STORAGE_KEY_TIR = 'labelnr_tir_open';
    var STORAGE_KEY_PRIORITY = 'labelnr_priority_filter';

    function getOpen(key) {
        try { return JSON.parse(localStorage.getItem(key)) || []; } catch(e) { return []; }
    }

    function setOpen(key, arr) {
        localStorage.setItem(key, JSON.stringify(arr));
    }

    function toggleItem(key, id, isOpen) {
        var arr = getOpen(key);
        if (isOpen) {
            if (arr.indexOf(id) === -1) arr.push(id);
        } else {
            arr = arr.filter(function(v) { return v !== id; });
        }
        setOpen(key, arr);
    }

    function restorePa() {
        var open = getOpen(STORAGE_KEY_PA);
        open.forEach(function(code) {
            var el = document.getElementById('collapse-' + code);
            if (el && !el.classList.contains('show')) {
                el.classList.add('show');
            }
            var trigger = document.querySelector('[data-bs-target="#collapse-' + code + '"]');
            if (trigger) trigger.setAttribute('aria-expanded', 'true');
        });
    }

    function restoreTir() {
        var open = getOpen(STORAGE_KEY_TIR);
        open.forEach(function(id) {
            var el = document.getElementById('collapse-tir-' + id);
            if (el && !el.classList.contains('show')) {
                el.classList.add('show');
            }
            var trigger = document.querySelector('[data-bs-target="#collapse-tir-' + id + '"]');
            if (trigger) trigger.setAttribute('aria-expanded', 'true');
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        restorePa();
        restoreTir();

        document.querySelectorAll('.collapse-pa').forEach(function(el) {
            var code = el.id.replace('collapse-', '');
            el.addEventListener('shown.bs.collapse', function() {
                toggleItem(STORAGE_KEY_PA, code, true);
            });
            el.addEventListener('hidden.bs.collapse', function() {
                toggleItem(STORAGE_KEY_PA, code, false);
            });
        });

        document.querySelectorAll('.collapse-tir').forEach(function(el) {
            var tirId = el.id.replace('collapse-tir-', '');
            el.addEventListener('shown.bs.collapse', function() {
                toggleItem(STORAGE_KEY_TIR, tirId, true);
            });
            el.addEventListener('hidden.bs.collapse', function() {
                toggleItem(STORAGE_KEY_TIR, tirId, false);
            });
        });

        document.querySelectorAll('.btn-toggle-all').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var target = btn.getAttribute('data-target');
                var action = btn.getAttribute('data-action');
                var show = action === 'show';
                document.querySelectorAll(target).forEach(function(el) {
                    var bsInstance = bootstrap.Collapse.getOrCreateInstance(el, {toggle: false});
                    if (show) {
                        bsInstance.show();
                    } else {
                        bsInstance.hide();
                    }
                });
                if (target === '.collapse-pa') {
                    var open = show ? Array.from(document.querySelectorAll('.collapse-pa')).map(function(el) { return el.id.replace('collapse-', ''); }) : [];
                    setOpen(STORAGE_KEY_PA, open);
                } else if (target === '.collapse-tir') {
                    var open = show ? Array.from(document.querySelectorAll('.collapse-tir')).map(function(el) { return el.id.replace('collapse-tir-', ''); }) : [];
                    setOpen(STORAGE_KEY_TIR, open);
                }
            });
        });

        var priorityFilter = document.getElementById('priority-filter');
        if (priorityFilter) {
            var savedPriority = localStorage.getItem(STORAGE_KEY_PRIORITY) || '';
            if (savedPriority) {
                priorityFilter.value = savedPriority;
            }

            function applyPriorityFilter(value) {
                document.querySelectorAll('.pa-row').forEach(function(row) {
                    if (value === '' || row.getAttribute('data-priority') === value) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            applyPriorityFilter(savedPriority);

            priorityFilter.addEventListener('change', function() {
                var selectedPriority = this.value;
                localStorage.setItem(STORAGE_KEY_PRIORITY, selectedPriority);
                applyPriorityFilter(selectedPriority);
            });
        }
    });
})();
</script>
{% endblock %}
