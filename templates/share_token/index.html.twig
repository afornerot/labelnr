{% extends 'base.html.twig' %}

{% block title %} - Liens de partage{% endblock %}

{% block body %}
    <h1>Liens de partage</h1>
    <p class="text-muted">Créez des liens de partage pour donner un accès en lecture seule à votre dossier.</p>
    
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-link"></i> Créer un nouveau lien
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('app_admin_share_token_create') }}">
                <div class="row g-3 align-items-end">
                    <div class="col-auto flex-grow-1">
                        <label for="label" class="visually-hidden">Nom du lien</label>
                        <input type="text" class="form-control" id="label" name="label" placeholder="Nom du lien (ex: Partage client XYZ)" required>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-plus"></i> Créer le lien
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="fas fa-table"></i> Liens existants
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered table-hover" id="dataTables" style="width:100%">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Créé le</th>
                        <th>Créé par</th>
                        <th width="300px">Lien</th>
                        <th width="70px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for token in tokens %}
                        <tr>
                            <td>{{ token.label }}</td>
                            <td>{{ token.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ token.createdBy ? token.createdBy.username : '-' }}</td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" readonly value="{{ url('app_share_view', {token: token.token}) }}">
                                    <button class="btn btn-outline-secondary copy-btn" type="button" data-copy="{{ url('app_share_view', {token: token.token}) }}" title="Copier">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                </div>
                            </td>
                            <td class="text-center">
                                <form method="post" action="{{ path('app_admin_share_token_delete', {id: token.id}) }}" onsubmit="return confirm('Supprimer ce lien de partage ?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                            <td>-</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block localscript %}
<script>
    $(document).ready(function() {
        $('#dataTables').DataTable({
            columnDefs: [
                { "targets": "no-sort", "orderable": false }
            ],
            responsive: true,
            iDisplayLength: 100,
            order: [[ 1, "desc" ]]
        });

        $('.copy-btn').on('click', function() {
            const text = $(this).data('copy');
            navigator.clipboard.writeText(text).then(function() {
                alert('Lien copié !');
            });
        });
    });
</script>
{% endblock %}
