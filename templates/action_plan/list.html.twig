{% extends 'base.html.twig' %}

{% block title %} = {{title}}{% endblock %}

{% block body %}
    <h1>{{title}}</h1>

    <div class="row">
        <div class="col-md-12 mx-auto">
            <div class="card">
                <div class="card-header">
                    <i class="fas fa-table fa-2x"></i>
                    <a href="{{ path(routesubmit) }}" class="btn btn-success float-end">Ajouter</a>
                </div>
                <div class="card-body">
                    <table id="dataTables" class="table table-striped table-bordered table-hover" style="width:100%">
                        <thead>
                        <tr>
                            <th width="70px" class="no-sort">Action</th>
                            <th>Priorité</th>
                            <th>Titre</th>
                            <th>TIRs</th>
                            <th>Statut</th>
                            <th>%</th>
                        </tr>
                        </thead>
                        <tbody>
                            {% for actionPlan in actionPlans %}
                                <tr>
                                    <td class="text-center"><a href="{{ path(routeupdate,{id:actionPlan.id}) }}"><i class="fas fa-file fa-2x"></i></a></td>
                                    <td class="text-center">{{actionPlan.priority}}</td>
                                    <td>{{actionPlan.title}}</td>
                                    <td>
                                        {% for tir in actionPlan.tirs %}
                                            <span class="badge bg-info me-1">{{tir.code}}</span>
                                        {% endfor %}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-{{ actionPlan.status.value == 'done' ? 'success' : actionPlan.status.value == 'in_progress' ? 'warning' : 'secondary' }}">
                                            {{actionPlan.status.label}}
                                        </span>
                                    </td>
                                    <td class="text-center">{{actionPlan.progress}}%</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block localscript %}
    <script>
        $(document).ready(function() {
            $('#dataTables').DataTable({
                columnDefs: [ { "targets": "no-sort", "orderable": false } ],
                responsive: true,
                iDisplayLength: 100,
                order: [[ 1, "asc" ]]
            });
        });
    </script>
{% endblock %}
