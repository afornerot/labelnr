{% extends 'base.html.twig' %}

{% block localstyle %}
<style>
    verysmall { zoom:70%; }

    big { zoom: 130%; }

    surline {
        background-color: #fff;
        color: #000;
        padding:5px;
        display: block;
        font-weight: bold;
        zoom: 130%;
    }

    #table-container { transition: opacity 0.3s ease; }

    .btn-collapse:hover {
        background-color: #f8f9fa !important;
        color: #000;
        filter: brightness(95%);
    }

    .btn-collapse::after {
        content: '▼';
        font-size: 0.8em;
        margin-left: 10px;
        transition: transform 0.3s;
    }

    .btn-collapse[aria-expanded="true"]::after {
        transform: rotate(180deg);
    }

    .textarea-comment {
        min-height: calc(3em + 0.75rem + 2px);
    }
</style>
{% endblock %}

{% block body %}
    {# On inclut le fragment pour le premier affichage au chargement de la page #}
    {% include 'home/table.html.twig' %}

    <div class="modal fade" id="dmrModal" tabindex="-1" role="dialog" aria-labelledby="dmrModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dmrModalLabel">Ajouter un élément</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="dmrForm">
                    <div class="modal-body">
                        <input type="hidden" id="dmrTirId" name="tirId">
                        <input type="hidden" id="dmrType" name="type">
                        <input type="hidden" id="dmrId" name="dmrId">
                        <div class="form-group">
                            <label for="dmrComment">Commentaire</label>
                            <textarea class="form-control" id="dmrComment" name="comment" rows="4" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer justify-content-between">
                        <div>
                            <button type="button" class="btn btn-danger" id="deleteDmrBtn" style="display: none;">Supprimer</button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                            <button type="submit" class="btn btn-primary">Enregistrer</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block localscript %}
<script>
    // --- Fonctions utilitaires de redimensionnement et d'état ---

    function autosize(textarea) {
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 10 + 'px';
    }

    function initializeAutosize() {
        $('.textarea-comment:visible').each(function() {
            autosize(this);
        });
    }

    function saveCollapseState() {
        var openIds = [];
        $('.collapse.show').each(function() {
            openIds.push($(this).attr('id'));
        });
        localStorage.setItem('openedCollapses', JSON.stringify(openIds));
    }

    function restoreCollapseState() {
        var stored = localStorage.getItem('openedCollapses');
        if (stored) {
            var openIds = JSON.parse(stored);
            openIds.forEach(function(id) {
                var $target = $('#' + id);
                if ($target.length) {
                    $target.addClass('show');
                    $(`[data-bs-target="#${id}"]`).attr('aria-expanded', 'true');
                }
            });
        }
    }

    // Libère le verrou de défilement de la page parfois laissé par l'ancienne instance détruite en plein écran
    function nettoyerVerrousDefilement() {
        document.body.style.overflow = 'auto';
        document.documentElement.style.overflow = 'auto';
        document.body.classList.remove('editor-fullscreen');
    }

    // --- Gestion et Initialisation d'EasyMDE ---

    // Variable globale pour stocker l'état visuel de l'éditeur actif avant l'écrasement du DOM par l'AJAX
    let etatEditeurPrecedent = null;

    function initializeEasyMDE() {
        // Sécurité : On nettoie le scroll de la page à chaque reconstruction du tableau
        nettoyerVerrousDefilement();

        document.querySelectorAll('.textarea-comment').forEach(function (textarea, index) {
            // Sécurité : On n'initialise pas si EasyMDE est déjà présent sur ce textarea
            if (textarea.style.display === 'none' || textarea.nextSibling?.classList?.contains('EasyMDEContainer')) {
                return;
            }

            const height = textarea.dataset.markdownHeight;
            const currentTirId = textarea.getAttribute('data-tir-id') || $(textarea).data('tir-id');

            const mdeInstance = new EasyMDE({
                element: textarea,
                spellChecker: false,
                status: false,
                minHeight: height ? `${height}px` : undefined,
                autosave: { enabled: false },
                toolbar: [
                    "bold", "italic", "heading", "|", 
                    "quote", "unordered-list", "ordered-list", "|", 
                    "link", "image", "|", 
                    "preview", "side-by-side", "fullscreen", "|",
                    {
                        name: "save",
                        action: function customSave(editor) {
                            // Si un mode d'affichage spécial est actif, on enregistre sa configuration
                            if (editor.isFullscreenActive() || editor.isSideBySideActive()) {
                                etatEditeurPrecedent = {
                                    tirId: currentTirId,
                                    fullscreen: editor.isFullscreenActive(),
                                    sideBySide: editor.isSideBySideActive()
                                };
                            }

                            // 1. Force la synchronisation avec le textarea d'origine
                            editor.toTextArea(); 

                            // 2. Déclenche manuellement l'événement change sur le textarea d'origine pour lancer l'AJAX
                            editor.element.dispatchEvent(new Event('change', { bubbles: true }));
                            console.log("Sauvegarde déclenchée via le bouton disquette.");
                        },
                        className: "fa fa-floppy-o", // Icône de disquette Font Awesome
                        title: "Enregistrer le commentaire", // Texte au survol
                    }
                ]
            });

            // Sauvegarde de l'instance EasyMDE directement sur l'élément du DOM natif au besoin
            textarea.easyMDEInstance = mdeInstance;

            // Variable locale pour stocker la valeur initiale au moment du focus dedans
            let valeurInitiale = "";

            mdeInstance.codemirror.on("focus", function () {
                valeurInitiale = mdeInstance.value();
            });

            mdeInstance.codemirror.on("blur", function () {
                const valeurActuelle = mdeInstance.value();

                // On ne déclenche la suite QUE si le texte a réellement changé
                if (valeurActuelle !== valeurInitiale) {
                    console.log("Changement réel détecté pour le tir-id " + currentTirId);

                    // Si le blur se produit pendant qu'un mode plein écran/scindé est actif
                    if (mdeInstance.isFullscreenActive() || mdeInstance.isSideBySideActive()) {
                        etatEditeurPrecedent = {
                            tirId: currentTirId,
                            fullscreen: mdeInstance.isFullscreenActive(),
                            sideBySide: mdeInstance.isSideBySideActive()
                        };
                    }

                    // Met à jour le textarea d'origine
                    mdeInstance.toTextArea(); 

                    // Déclenche le 'change' qui va activer le script jQuery AJAX
                    textarea.dispatchEvent(new Event('change', { bubbles: true }));
                } else {
                    console.log("Sortie de l'éditeur sans modification (pas d'AJAX).");
                }
            });

            // Sécurité : Si l'utilisateur quitte le mode plein écran à la main (ex: touche Échap)
            mdeInstance.codemirror.on("fullscreenHide", function() {
                nettoyerVerrousDefilement();
            });

            // RESTAURATION DES MODES : Si cet éditeur correspond à l'état sauvegardé juste avant l'AJAX
            if (etatEditeurPrecedent && String(etatEditeurPrecedent.tirId) === String(currentTirId)) {
                setTimeout(function() {
                    if (etatEditeurPrecedent.fullscreen && !mdeInstance.isFullscreenActive()) {
                        mdeInstance.toggleFullScreen();
                    }
                    if (etatEditeurPrecedent.sideBySide && !mdeInstance.isSideBySideActive()) {
                        mdeInstance.toggleSideBySide();
                    }

                    mdeInstance.codemirror.focus();
                    etatEditeurPrecedent = null; // Reset de la mémoire de l'état
                }, 50);
            }
        });
    }

    // --- Rituels au chargement et Écouteurs d'événements jQuery ---

    $(document).ready(function() {
        restoreCollapseState();
        initializeAutosize();
        initializeEasyMDE();    

        $(document).on('shown.bs.collapse', '.collapse', function () {
            saveCollapseState();
            $(this).find('.textarea-comment').each(function() {
                autosize(this);
            });
        });

        $(document).on('hidden.bs.collapse', '.collapse', function () {
            saveCollapseState();
        });

        $(document).on('input', '.textarea-comment', function() {
            autosize(this);
        });

        // Modification de la maturité
        $(document).on('change', '.select-maturity', function() {
            const $select = $(this);
            const data = {
                tirId: $select.data('tir-id'),
                maturityId: $select.val()
            };

            $('#table-container').css('opacity', 0.5);

            $.ajax({
                url: "{{ path('app_tir_updatematurity') }}",
                method: 'POST',
                data: data,
                success: function(response) {
                    $('#table-container').replaceWith(response);
                    restoreCollapseState();
                    initializeEasyMDE(); // Réinitialise EasyMDE sur le nouveau HTML reçu
                    setTimeout(initializeAutosize, 1);
                },
                error: function() {
                    alert("Erreur lors de la mise à jour des données.");
                    $('#table-container').css('opacity', 1);
                }
            });
        });

        // Sauvegarde AJAX du commentaire (Déclenché par notre dispatchEvent)
        $(document).on('change', '.textarea-comment', function() {
            console.log("Changement détecté dans un textarea-comment");
            const $textarea = $(this);
            const data = {
                tirId: $textarea.data('tir-id'),
                comment: $textarea.val()
            };

            $('#table-container').css('opacity', 0.5);

            $.ajax({
                url: "{{ path('app_tir_updatecomment') }}",
                method: 'POST',
                data: data,
                success: function(response) {
                    // Remplace le DOM (ce qui détruit les anciennes instances d'EasyMDE)
                    $('#table-container').replaceWith(response);
                    
                    restoreCollapseState();
                    
                    // La réinitialisation va intercepter l'objet "etatEditeurPrecedent" s'il existe et le restaurer
                    initializeEasyMDE();
                                        
                    setTimeout(initializeAutosize, 1);
                },
                error: function() {
                    alert("Erreur lors de la mise à jour du commentaire.");
                    $('#table-container').css('opacity', 1);
                    etatEditeurPrecedent = null; // Nettoyage de l'état en cas d'échec
                }
            });
        });

        // --- Gestion de la modale DMR ---

        $('#dmrModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var modal = $(this);
            var deleteBtn = modal.find('#deleteDmrBtn');
            
            modal.find('#dmrId').val('');
            modal.find('#dmrTirId').val('');
            modal.find('#dmrType').val('');
            modal.find('#dmrComment').val('');
            deleteBtn.hide();

            if (button.data('dmr-id')) {
                var dmrId = button.data('dmr-id');
                var comment = button.html().replace(/<br\s*\/?>/gi, "\n");
                
                modal.find('.modal-title').text('Modifier l\'élément');
                modal.find('#dmrId').val(dmrId);
                modal.find('#dmrComment').val(comment);
                deleteBtn.show();
            } else {
                var tirId = button.data('tir-id');
                var dmrType = button.data('dmr-type');
                var typeText = dmrType.charAt(0).toUpperCase() + dmrType.slice(1);

                modal.find('.modal-title').text('Ajouter : ' + typeText);
                modal.find('#dmrTirId').val(tirId);
                modal.find('#dmrType').val(dmrType);
            }
            
            setTimeout(function() {
                modal.find('#dmrComment').focus();
            }, 500);
        });

        $('#dmrForm').on('submit', function(e) {
            e.preventDefault();

            const $form = $(this);
            const data = $form.serialize();
            const dmrId = $form.find('#dmrId').val();
            
            const url = dmrId ? "{{ path('app_tir_updatedmr') }}" : "{{ path('app_tir_submitdmr') }}";

            $('#table-container').css('opacity', 0.5);
            $('#dmrModal').modal('hide');

            $.ajax({
                url: url,
                method: 'POST',
                data: data,
                success: function(response) {
                    $('#table-container').replaceWith(response);
                    restoreCollapseState();
                    initializeEasyMDE(); // Réinitialise EasyMDE sur le nouveau HTML reçu
                    setTimeout(initializeAutosize, 1);
                },
                error: function() {
                    alert("Erreur lors de l'enregistrement.");
                    $('#table-container').css('opacity', 1);
                }
            });
        });

        $('#deleteDmrBtn').on('click', function() {
            if (!confirm("Êtes-vous sûr de vouloir supprimer cet élément ?")) {
                return;
            }

            const dmrId = $('#dmrId').val();
            if (!dmrId) {
                alert('Erreur : ID de l\'élément non trouvé.');
                return;
            }

            $('#table-container').css('opacity', 0.5);
            $('#dmrModal').modal('hide');

            $.ajax({
                url: "{{ path('app_tir_deletedmr') }}",
                method: 'POST',
                data: { dmrId: dmrId },
                success: function(response) {
                    $('#table-container').replaceWith(response);
                    restoreCollapseState();
                    initializeEasyMDE(); // Réinitialise EasyMDE sur le nouveau HTML reçu
                    setTimeout(initializeAutosize, 1);
                },
                error: function() {
                    alert("Erreur lors de la suppression de l'élément.");
                    $('#table-container').css('opacity', 1);
                }
            });
        });

        $(document).on('click', '.btn-toggle-all', function() {
            var target = $(this).data('target');
            var action = $(this).data('action');
            $(target).collapse(action);
        });
        
    });
</script>
{% endblock %}