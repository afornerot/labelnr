{% macro pa_evaluation(score) %}
    {% if score > 749 %}
        Raisonnable
    {% elseif score > 349 %}
        Partiel
    {% elseif score >= 0 %}
        Faible
    {% else %}
        NA
    {% endif %}
{% endmacro %}
{% import _self as macros %}

<div id="table-container">
    {% if shareLabel is defined %}
    <div class="alert alert-info mb-3">
        <i class="fas fa-share-alt"></i> {{ shareLabel }}
    </div>
    {% endif %}
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3>SCORE = {{ score|number_format(0, '.', '') }}</h3>
        <div class="d-flex align-items-center">
            <div class="btn-group btn-group-sm me-2">
                <button type="button" class="btn btn-outline-primary btn-toggle-all" data-target=".collapse-pa" data-action="show" title="Tout déplier PA">PA +</button>
                <button type="button" class="btn btn-outline-primary btn-toggle-all" data-target=".collapse-pa" data-action="hide" title="Tout replier PA">PA -</button>
            </div>
            <div class="btn-group btn-group-sm me-3">
                <button type="button" class="btn btn-outline-secondary btn-toggle-all" data-target=".collapse-tir" data-action="show" title="Tout déplier TIR">TIR +</button>
                <button type="button" class="btn btn-outline-secondary btn-toggle-all" data-target=".collapse-tir" data-action="hide" title="Tout replier TIR">TIR -</button>
            </div>
            <label class="me-2 fw-bold">Priorité TIR:</label>
            <select id="priority-filter" class="form-select form-select-sm" style="width: auto;">
                <option value="">Toutes</option>
                {% for materiality in materialities %}
                    <option value="{{ materiality.code }}">{{ materiality.title }}</option>
                {% endfor %}
            </select>
            <label class="me-2 fw-bold ms-3">Score TIR:</label>
            <select id="maturity-filter" class="form-select form-select-sm" style="width: auto;">
                <option value="">Tous</option>
                <option value="0">0</option>
                <option value="500">500</option>
                <option value="1000">1000</option>
            </select>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">
            <i class="fas fa-list-check me-2"></i>Plan d'action
        </div>
        <div class="card-body">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Prio</th>
                        <th>Action</th>
                        <th>TIRs</th>
                        <th>Statut</th>
                        <th>%</th>
                    </tr>
                </thead>
                <tbody>
                    {% for actionPlan in actionPlans|sort((a, b) => a.priority <=> b.priority) %}
                    <tr>
                        <td class="text-center">P{{actionPlan.priority}}</td>
                        <td>{{actionPlan.title}}</td>
                        <td>
                            {% for tir in actionPlan.tirs %}
                                <span class="badge bg-info me-1">{{tir.code}}</span>
                            {% endfor %}
                        </td>
                        <td class="text-center">
                            <span class="badge bg-{{ actionPlan.status.value == 'done' ? 'success' : actionPlan.status.value == 'in_progress' ? 'warning' : 'secondary' }}">
                                {{actionPlan.status.label}}
                            </span>
                        </td>
                        <td class="text-center">{{actionPlan.progress}}%</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="row">
        <table class="table table-bordered table-hover" style="width:100%">
            <thead>
                <tr>
                    <th width="200px">Axe</th>
                    <th>PA</th>
                </tr>
            </thead>
            <tbody>
            {% for thematicCode, data in groupedPas %}
                <tr class="axe-row" data-thematic="{{ thematicCode }}" style="border-bottom: 20px solid #222;">
                    <td style="text-align:center; vertical-align: top; background-color: #495057; color: white;">
                        <center>
                            <surline class="mb-3">
                                SCORE<br>
                                {{ data.thematic.score|number_format(2, '.', '') }}<br>
                            </surline>
                            {{ data.thematic.code }}<br>
                            {{ data.thematic.title }}<br><br>
                            <verysmall>pondération = {{ data.thematic.length }}</verysmall><br>
                        </center>
                    </td>
                    <td style="padding: 10px;">
                        {% for pa in data.pas %}
                            <div class="pa-accordion mb-2" data-priority="{{ pa.materiality.code }}">
                                <surline class="d-flex btn-collapse"
                                         style="cursor: pointer;"
                                         data-bs-toggle="collapse"
                                         data-bs-target="#collapse-{{ pa.code }}"
                                         aria-expanded="false"
                                         aria-controls="collapse-{{ pa.code }}">
                                    <span class="flex-grow-1"><strong>{{ pa.code }}</strong> = {{ pa.title }}</span>
                                    <span>{{ pa.score|number_format(0, '.', '') }}</span>
                                </surline>

                                <div class="collapse mt-2 collapse-pa" id="collapse-{{ pa.code }}">
                                    <div class="pa-details p-2 border rounded">
                                        <verysmall>
                                            Score = {{ pa.score|number_format(0, '.', '') }} |
                                            Evaluation = {{ macros.pa_evaluation(pa.score) }} |
                                            pondération = {{ pa.tirs|length }} |
                                            priorité = {{ pa.materiality.title }}
                                        </verysmall>

                                        <table class="table table-sm table-striped table-bordered mt-2" style="width:100%;">
                                            <thead>
                                                <tr>
                                                    <th width="70px"></th>
                                                    <th>TIR</th>
                                                    <th width="70px">%</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            {% for tir in pa.tirs %}
                                                <tr data-maturity="{{ tir.maturity.value }}">
                                                    <td width="70px" valign="top" align="center">
                                                        {% if readOnly is not defined or not readOnly %}
                                                        <a href="{{ path('app_tir_edit', {id: tir.id}) }}" class="btn btn-sm btn-primary" title="Modifier">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        {% endif %}
                                                    </td>

                                                    <td style="padding:0px 10px 10px 10px;">
                                                        <div class="d-flex btn-collapse align-items-center"
                                                             style="cursor: pointer;"
                                                             data-bs-toggle="collapse"
                                                             data-bs-target="#collapse-tir-{{ tir.id }}"
                                                             aria-expanded="false"
                                                             aria-controls="collapse-tir-{{ tir.id }}">
                                                            <div class="flex-grow-1" style="font-size:20px; padding: 3px 0px;">{{ tir.code }} = {{ tir.title }}</div>
                                                        </div>
                                                        <div class="collapse collapse-tir" id="collapse-tir-{{ tir.id }}">
                                                            <div class="card mt-3">
                                                                <div class="card-header">
                                                                    Commentaire
                                                                </div>
                                                                <div class="card-body">
                                                                    {% if tir.comment %}
                                                                        {{ tir.comment|markdown_to_html }}
                                                                    {% else %}
                                                                        <em class="text-muted">Aucun commentaire</em>
                                                                    {% endif %}
                                                                </div>
                                                            </div>

                                                            <div class="card mt-3">
                                                                <div class="card-header">
                                                                    DMR
                                                                </div>
                                                                <div class="card-body">
                                                                    <table class="table table-sm table-striped table-bordered mt-2" style="width:100%;">
                                                                        <thead>
                                                                            <tr>
                                                                                <td width="33.33333%">Documentation</td>
                                                                                <td width="33.33333%">Moyen</td>
                                                                                <td width="33.33333%">Résultat</td>
                                                                            </tr>
                                                                        </thead>

                                                                        <tr>
                                                                            <td>
                                                                                {% for doc in tir.dmrs|filter(d => d.type.value == 'documentation') %}
                                                                                    {{ not loop.first ? "<hr>" : "" }}
                                                                                    <p>{{ doc.comment|markdown_to_html }}</p>
                                                                                {% endfor %}
                                                                            </td>
                                                                            <td>
                                                                                {% for doc in tir.dmrs|filter(d => d.type.value == 'moyen') %}
                                                                                    {{ not loop.first ? "<hr>" : "" }}
                                                                                    <p>{{ doc.comment|markdown_to_html }}</p>
                                                                                {% endfor %}
                                                                            </td>
                                                                            <td>
                                                                                {% for doc in tir.dmrs|filter(d => d.type.value == 'resultat') %}
                                                                                    {{ not loop.first ? "<hr>" : "" }}
                                                                                    <p>{{ doc.comment|markdown_to_html }}</p>
                                                                                {% endfor %}
                                                                            </td>
                                                                        </tr>
                                                                    </table>
                                                                </div>
                                                            </div>

                                                            {{ render(path("bninefiles_files", shareToken is defined ? {domain: 'evidence', id: tir.id, editable: 0, shareToken: shareToken} : {domain: 'evidence', id: tir.id, editable: 0})) }}
                                                        </div>
                                                    </td>

                                                    <td width="70px" class="text-center font-weight-bold">
                                                        {{ tir.maturity.value }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
