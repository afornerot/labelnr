{% extends 'base.html.twig' %}

{% block localstyle %}
<style>
    .tir-header {
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    
    .tir-code {
        font-size: 2em;
        font-weight: bold;
    }
    
    .tir-title {
        font-size: 1.5em;
        margin-bottom: 10px;
    }
    
    .dmr-item {
        padding: 10px;
        margin-bottom: 10px;
        border-radius: 4px;
        border: 1px solid var(--bs-border-color);
    }

    .card-comment h1, {
        font-size: 2rem;
    }
    .card-comment h2 {
        font-size: 1.7rem;
        border-bottom: 1px solid #f8f9fa;
    }
    .card-comment h3 {
        font-size: 1.4rem;
    }    
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="tir-header">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="tir-code">{{ tir.code }}</div>
                        <div class="tir-title">{{ tir.title }}</div>
                        {% if tir.summary %}
                            <p class="text-muted">{{ tir.summary }}</p>
                        {% endif %}
                    </div>
                    <div>
                        <a href="{{ path('app_tir_edit', {id: tir.id}) }}" class="btn btn-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        <a href="{{ path('app_home', {scrollToTir: tir.id}) }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">PA - {{ tir.pa.code }}</h5>
                        </div>
                        <div class="card-body">
                            <p><strong>{{ tir.pa.title }}</strong></p>
                            <p class="mb-0">
                                <span class="badge bg-primary">Score: {{ tir.pa.score }}</span>
                                <span class="badge bg-secondary">Priorité: {{ tir.pa.materiality.title }}</span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Maturité</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-0">
                                <span class="badge bg-info">{{ tir.maturity.title }}</span>
                                <span class="badge bg-success">{{ tir.maturity.value }}</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {% if tir.description %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Description</h5>
                    </div>
                    <div class="card-body">
                        {{ tir.description|nl2br }}
                    </div>
                </div>
            {% endif %}

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Commentaire</h5>
                </div>
                <div class="card-body card-comment">
                    {% if tir.comment %}
                        {{ tir.comment|markdown_to_html }}
                    {% else %}
                        <em class="text-muted">Aucun commentaire</em>
                    {% endif %}
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">DMR</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <h5 class="mb-3">Documentation</h5>
                            {% for dmr in tir.dmrs|filter(d => d.type.value == 'documentation') %}
                                <div class="dmr-item">
                                    {{ dmr.comment|markdown_to_html }}
                                </div>
                            {% else %}
                                <p class="text-muted">Aucun élément</p>
                            {% endfor %}
                        </div>
                        <div class="col-md-4">
                            <h5 class="mb-3">Moyen</h5>
                            {% for dmr in tir.dmrs|filter(d => d.type.value == 'moyen') %}
                                <div class="dmr-item">
                                    {{ dmr.comment|markdown_to_html }}
                                </div>
                            {% else %}
                                <p class="text-muted">Aucun élément</p>
                            {% endfor %}
                        </div>
                        <div class="col-md-4">
                            <h5 class="mb-3">Résultat</h5>
                            {% for dmr in tir.dmrs|filter(d => d.type.value == 'resultat') %}
                                <div class="dmr-item">
                                    {{ dmr.comment|markdown_to_html }}
                                </div>
                            {% else %}
                                <p class="text-muted">Aucun élément</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                {{ render(path("bninefiles_files", {domain: 'evidence', id: tir.id, editable: 0})) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
